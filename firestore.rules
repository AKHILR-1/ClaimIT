rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security checks
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSameOrg(orgId) {
      return isSignedIn() && request.auth.token.organizationId == orgId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'ADMIN';
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Item Posts Collection (Organisational Isolation)
    match /organizations/{orgId}/items/{itemId} {
      allow read: if isSignedIn() && isSameOrg(orgId);
      allow create: if isSignedIn() && isSameOrg(orgId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isSameOrg(orgId) && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && request.resource.data.userId == request.auth.uid);
    }

    // Private Claims Collection (Restricted to Claimant, Listing Owner, or Admin)
    match /organizations/{orgId}/claims/{claimId} {
      allow read: if isSignedIn() && isSameOrg(orgId) &&
        (resource.data.claimantId == request.auth.uid || resource.data.itemOwnerOrFinderId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isSameOrg(orgId) && request.resource.data.claimantId == request.auth.uid;
      allow update: if isSignedIn() && isSameOrg(orgId) &&
        (resource.data.itemOwnerOrFinderId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Reports / Moderation Queue (Admin restricted)
    match /organizations/{orgId}/reports/{reportId} {
      allow create: if isSignedIn() && isSameOrg(orgId) && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Notifications
    match /users/{userId}/notifications/{notificationId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isSignedIn();
    }
  }
}
