{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        "collegeEmail": {
          ".validate": "!data.exists() || data.val() === newData.val()"
        },
        "registrationNumber": {
          ".validate": "!data.exists() || data.val() === newData.val()"
        },
        "role": {
          ".validate": "!data.exists() || (data.val() === newData.val() || auth.token.admin === true)"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null"
      }
    },
    "claims": {
      ".read": "auth != null",
      "$claimId": {
        ".read": "auth != null && (!data.exists() || data.child('claimantUid').val() === auth.uid || data.child('uploaderUid').val() === auth.uid || auth.token.admin === true)",
        ".write": "auth != null"
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        "$deviceId": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "deviceSessions": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.admin === true)",
        ".write": "auth != null && (auth.uid === $uid || auth.token.admin === true)"
      }
    },
    "moderationReports": {
      ".read": "auth != null",
      "$reportId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "moderationAudit": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "adminConfiguration": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.admin === true"
    },
    "organizations": {
      "$orgId": {
        "items": {
          ".read": "auth != null && (root.child('users').child(auth.uid).child('organizationId').val() === $orgId || root.child('users').child(auth.uid).child('collegeId').val() === $orgId || auth.token.admin === true || !root.child('users').child(auth.uid).exists())",
          "$itemId": {
            ".write": "auth != null && (!data.exists() ? (newData.child('userId').val() === auth.uid || newData.child('ownerUid').val() === auth.uid || auth.token.admin === true) : (data.child('userId').val() === auth.uid || data.child('ownerUid').val() === auth.uid || auth.token.admin === true))",
            ".validate": "newData.hasChildren(['title', 'type', 'category'])"
          }
        }
      }
    },
    "items": {
      ".read": "auth != null",
      "$itemId": {
        ".write": "auth != null && (!data.exists() ? (newData.child('userId').val() === auth.uid || newData.child('ownerUid').val() === auth.uid || auth.token.admin === true) : (data.child('userId').val() === auth.uid || data.child('ownerUid').val() === auth.uid || auth.token.admin === true))",
        ".validate": "newData.hasChildren(['title', 'type', 'category'])"
      }
    }
  }
}
